[Unit]
Description=Robot dashboard fixed web interface
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.local/share/robot-dashboard/current/projects/ammr-live
ExecStart=/usr/bin/python3 %h/.local/share/robot-dashboard/current/projects/ammr-live/web_server.py --bind 127.0.0.1 --port 8090 --backend-port 18091
Restart=always
RestartSec=3
TimeoutStopSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
